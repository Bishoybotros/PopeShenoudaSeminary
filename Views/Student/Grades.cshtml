@model List<PopeShenoudaSeminary.Models.StudentSubjectGrade>

@{
    ViewData["Title"] = "درجاتي";
}

@section Styles {
    <style>
        :root {
            --navy: #5C4033; /* Espresso */
            --navy-light: #6F4E37;
            --gold: #C69C6D; /* Caramel */
            --gold-light: #D2B48C;
            --surface: #F5EFE6; /* Latte */
            --card: #FFFDF9; /* Vanilla */
            --border: #E6D8C9; /* Cream */
            --text-main: #4B3621;
            --text-muted: #8B7355;
            --success: #6B8E23;
            --warning: #A67B5B;
            --danger: #B22222;
            --radius: 12px;
            --shadow: 0 4px 16px rgba(92,64,51,.12);
        }

        .page-header {
            background: linear-gradient( 135deg, #5C4033 0%, #6F4E37 100% );
            padding: 2rem 0 1.75rem;
            margin-bottom: 2rem;
            position: relative;
        }

            .page-header h1 {
                color: #fff;
                font-size: 1.5rem;
                font-weight: 700;
                margin: 0;
            }

            .page-header p {
                color: rgba(255,255,255,.6);
                font-size: .85rem;
                margin: .3rem 0 0;
            }

        .back-link {
            color: rgba(255,255,255,.7);
            font-size: .83rem;
            text-decoration: none;
        }

            .back-link:hover {
                color: #fff;
            }

        .grades-card,
        .summary-box {
            background: var(--card);
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
        }
        .grades-table {
            margin: 0;
        }

            .grades-table thead th {
                background: rgba(92,64,51,.06);
                color: var(--navy);
            
                font-size: .78rem;
                font-weight: 700;
                letter-spacing: .06em;
                text-transform: uppercase;
                border-bottom: 2px solid var(--border);
                padding: .85rem 1.25rem;
            }

            .grades-table tbody td {
                padding: .9rem 1.25rem;
                vertical-align: middle;
                border-bottom: 1px solid var(--border);
                font-size: .9rem;
            }

            .grades-table tbody tr:last-child td {
                border-bottom: none;
            }

            .grades-table tbody tr:hover {
                background: rgba(26,58,92,.025);
            }

        .subject-name {
            font-weight: 600;
            color: #1e2535;
        }

        .score-pill {
            display: inline-block;
            padding: .3rem .85rem;
            border-radius: 20px;
            font-size: .82rem;
            font-weight: 700;
        }

        .score-excellent {
            background: rgba(22,128,60,.12);
            color: #16803c;
        }

        .score-good {
            background: rgba(37,99,235,.1);
            color: #1d4ed8;
        }

        .score-average {
            background: rgba(184,147,58,.15);
            color: #92400e;
        }

        .score-pass {
            background: rgba(124,45,18,.1);
            color: #7c2d12;
        }

        .score-fail {
            background: rgba(220,38,38,.1);
            color: #dc2626;
        }

        .bar-cell {
            width: 220px;
        }

        .mini-bar-wrap {
            height: 6px;
            background: var(--border);
            border-radius: 99px;
            overflow: hidden;
        }

        .mini-bar {
            height: 100%;
            border-radius: 99px;
        }

        .summary-box {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.25rem;
            box-shadow: var(--shadow);
            text-align: center;
        }

        .summary-val {
            font-size: 2rem;
            font-weight: 800;
            color: var(--navy);
        }

        .summary-lbl {
            font-size: .8rem;
            color: #6b7280;
            margin-top: .2rem;
        }
    </style>
}

<div class="page-header">
    <div class="container">
        <a asp-controller="Student" asp-action="Dashboard" class="back-link">
            <i class="bi bi-arrow-right"></i> العودة للوحة الطالب
        </a>
        <h1 class="mt-2">درجاتي</h1>
        <p>نتائجك الأكاديمية للفصل الدراسي الحالي</p>
    </div>
</div>

<div class="container pb-4">
    <div class="preloader">
        <span>LOADING</span>
        <span class="loader"></span>
    </div>
    <!-- Summary row -->
    <!-- Summary row -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="summary-box">
                <div class="summary-val">@Model.Count</div>
                <div class="summary-lbl">إجمالي المواد</div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="summary-box">
                <div class="summary-val" style="color:#16803c">
                    @Model.Count(g => g.Score >= g.Subject.MinScore)
                </div>
                <div class="summary-lbl">مواد ناجحة</div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="summary-box">
                <div class="summary-val" style="color:#dc2626">
                    @Model.Count(g => g.Score < g.Subject.MinScore)
                </div>
                <div class="summary-lbl">مواد راسبة</div>
            </div>
        </div>


        <div class="col-6 col-md-3">
            <div class="summary-box">

                <div class="summary-val" style="color:var(--gold)">
                    @(Model.Any()
                                        ? Math.Round(
                                        Model.Average(g =>
                                        ((double)g.Score / g.Subject.MaxScore) * 100
                                        ), 1) + "%"
                                        : "—")
                </div>

                <div class="summary-lbl">المتوسط العام</div>

            </div>
        </div>

    </div>



    <!-- Grades table -->

    <div class="grades-card">

        <table class="table grades-table">

            <thead>
                <tr>
                    <th>#</th>
                    <th>المادة</th>
                    <th class="bar-cell d-none d-md-table-cell">
                        التقدم
                    </th>
                    <th>الدرجة</th>
                    <th>التقدير</th>
                </tr>
            </thead>


